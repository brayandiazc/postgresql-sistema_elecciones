# ==============================================================================
# Variables de entorno — Sistema de Votación PostgreSQL
# ==============================================================================
# Copia este archivo a `.env` y completa los valores para tu entorno.
#   cp .env.example .env
#
# NUNCA subas tu archivo `.env` con valores reales al repositorio.
# Ver SECURITY.md y docs/conventions/secrets.md.
#
# Estas variables son opcionales: sirven para no repetir credenciales al invocar
# `psql`. psql las reconoce de forma nativa (PGHOST, PGPORT, PGUSER, PGDATABASE).
# ==============================================================================

# ── Conexión a PostgreSQL ─────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=tu_usuario
# La contraseña; déjala vacía y usa ~/.pgpass si prefieres no guardarla aquí.
PGPASSWORD=
PGDATABASE=sistema_votacion
